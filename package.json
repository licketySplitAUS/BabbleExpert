{
  "name": "babble-expert",
  "version": "3.3.0",
  "description": "Babble Expert: Babble and the Babble Clues page side by side, with one-click sending of words in both directions.",
  "main": "src/main.js",
  "author": "licketySplitAUS",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node test/e2e/run.js e2e-main.js --no-sandbox",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "test:real-clues": "node test/e2e/run.js real-clues.js --no-sandbox",
    "release:check": "node tools/release/check.cjs",
    "test:packaged": "node tools/release/packaged-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "yaml": "2.9.1"
  },
  "build": {
    "appId": "au.licketysplit.babbleexpert",
    "buildVersion": "3.3.0.0",
    "productName": "Babble Expert",
    "copyright": "licketySplitAUS",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "RELEASE_NOTES.md"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "licketySplitAUS",
      "repo": "BabbleExpert"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "BabbleExpert-Windows-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "dmg": {
      "artifactName": "BabbleExpert-macOS.${ext}"
    },
    "linux": {
      "target": "dir"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
